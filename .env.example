# ==============================================================================
# Sanchari • Micro Trips — Environment Variables Example
# Copy this file to .env.local for local development.
# NEVER commit .env.local or paste real production secrets into source control.
# ==============================================================================

# --- Public Client & Server URL (safe for browser bundle) ---
# Obtained from: Supabase Dashboard -> Project Settings -> General / API
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Public Publishable / Anon Key — safe only with RLS enabled) ---
# Obtained from: Supabase Dashboard -> Project Settings -> API -> Project URL & anon/publishable key
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key

# --- Supabase Server-Only Secret Key (NEVER prefix with NEXT_PUBLIC_) ---
# Obtained from: Supabase Dashboard -> Project Settings -> API -> service_role / secret key
# Used ONLY in server-side route handlers, webhooks, and trusted admin actions.
# Use the project-specific name: a generic SUPABASE_SERVICE_ROLE_KEY set system-wide by another
# project would override .env.local. Accepts the new sb_secret_… key or the legacy service_role JWT.
SANCHARI_SUPABASE_SECRET_KEY=your-supabase-secret-key

# --- Payment Gateway: Razorpay (Server-Only + Public Key ID) ---
# Obtained from: Razorpay Dashboard -> Account & Settings -> API Keys & Webhooks
# Leave empty until owner enables live/test Razorpay credentials.
# upi (default) = customers pay your own UPI ID set in Admin -> UPI Settings; razorpay = needs all 3 keys below
PAYMENT_PROVIDER=upi
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Messaging: WhatsApp Business / Click-to-WhatsApp Fallback ---
# Public support number for click-to-WhatsApp fallback (format: 91XXXXXXXXXX, no +)
NEXT_PUBLIC_WHATSAPP_SUPPORT_NUMBER=
# Optional official WhatsApp Cloud API (server-only, leave empty until templates approved)
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# --- Optional Email Confirmation (Resend or SMTP, server-only) ---
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=

# --- Booking Lookup Signing Secret (Server-Only, >= 32 random chars) ---
# Used to sign guest booking lookup tokens; generate with `openssl rand -hex 32`
BOOKING_LOOKUP_SECRET=replace-with-at-least-32-character-random-secret


# --- Separate admin link (optional) ---
# Set to the admin's own host (e.g. admin.sancharitrips.in) to serve the admin panel ONLY there;
# the public site then returns 404 for /admin. Leave empty for localhost.
ADMIN_HOST=
